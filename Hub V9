local function createESP(otherPlayer)
    if espObjects[otherPlayer] then return end
    local line = Instance.new("Frame", ScreenGui)
    line.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Visible = false
    line.ZIndex = 4
    espObjects[otherPlayer] = {Line = line}
end

local function removeESP(otherPlayer)
    if espObjects[otherPlayer] then
        if espObjects[otherPlayer].Line then
            espObjects[otherPlayer].Line:Destroy()
        end
        espObjects[otherPlayer] = nil
    end
end

local function OnCharacterAdded(characterObj, otherPlayer)
    if otherPlayer == player then return end
    characterObj:WaitForChild("HumanoidRootPart", 10)
    if characterObj:FindFirstChild("MyEspHighlight") then
        characterObj.MyEspHighlight:Destroy()
    end
    local highlight = Instance.new("Highlight")
    highlight.Name = "MyEspHighlight"
    highlight.Adornee = characterObj
    highlight.FillColor = EspColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = EspColor
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = features.esp
    highlight.Parent = characterObj
end

local function OnPlayerAdded(otherPlayer)
    if otherPlayer ~= player then
        createESP(otherPlayer)
        if otherPlayer.Character then
            OnCharacterAdded(otherPlayer.Character, otherPlayer)
        end
        otherPlayer.CharacterAdded:Connect(function(char)
            OnCharacterAdded(char, otherPlayer)
        end)
    end
end

Players.PlayerAdded:Connect(OnPlayerAdded)
Players.PlayerRemoving:Connect(removeESP)

for _, p in pairs(Players:GetPlayers()) do
    if p ~= player then OnPlayerAdded(p) end
end

connections.espLoop = RunService.Heartbeat:Connect(function()
    pcall(function()
        local viewportSize = camera.ViewportSize
        for other, data in pairs(espObjects) do
            local line = data.Line
            line.Visible = false
            if features.esp then
                local otherChar = other.Character
                if otherChar then
                    local root = otherChar:FindFirstChild("HumanoidRootPart")
                    local hum = otherChar:FindFirstChild("Humanoid")
                    if root and hum and hum.Health > 0 then
                        local rootPos, onScreen = camera:WorldToViewportPoint(root.Position)
                        if onScreen then
                            line.Visible = true
                            local startX, startY = viewportSize.X / 2, viewportSize.Y
                            local targetX, targetY = rootPos.X, rootPos.Y
                            local distance = math.sqrt((targetX - startX)^2 + (targetY - startY)^2)
                            line.Size = UDim2.new(0, 1.5, 0, distance)
                            line.Position = UDim2.new(0, (startX + targetX) / 2, 0, (startY + targetY) / 2)
                            line.Rotation = math.deg(math.atan2(targetY - startY, targetX - startX)) - 90
                        end
                    end
                end
            end
        end
    end)
end)

local function setESP(state)
    features.esp = state
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("MyEspHighlight") then
            p.Character.MyEspHighlight.Enabled = state
        end
    end
end

local function getPlayersInCircle()
    if not rootPart or not rootPart.Parent then return {} end
    local myPos = rootPart.Position
    local targets = {}
    
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (otherRoot.Position - myPos).Magnitude
                    if dist <= circleRadius then
                        table.insert(targets, {Player = other, Root = otherRoot, Distance = dist})
                    end
                end
            end
        end
    end
    table.sort(targets, function(a,b) return a.Distance < b.Distance end)
    return targets
end

local function setAim(state)
    features.aim = state
    if state and not connections.aim then
        connections.aim = RunService.Heartbeat:Connect(function()
            if not features.aim then return end
            pcall(function()
                local targets = getPlayersInCircle()
                if #targets > 0 then
                    local target = targets[1]
                    local otherChar = target.Player.Character
                    if otherChar then
                        local head = otherChar:FindFirstChild("Head") or target.Root
                        if head then
                            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
                        end
                    end
                end
            end)
        end)
    elseif not state and connections.aim then
        connections.aim:Disconnect()
        connections.aim = nil
    end
end

local function setFling(state)
    features.fling = state
    if state and not connections.fling then
        connections.fling = RunService.Heartbeat:Connect(function()
            if not features.fling then return end
            pcall(function()
                if not rootPart or not rootPart.Parent then return end
                local myPos = rootPart.Position
                
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= player then
                        local otherChar = other.Character
                        if otherChar then
                            local root = otherChar:FindFirstChild("HumanoidRootPart")
                            if root and (root.Position - myPos).Magnitude < 50 then
                                local dir = (root.Position - myPos).Unit
                                root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + (dir * Vector3.new(math.random(400,800), math.random(300,600), math.random(400,800)))
                            end
                        end
                    end
                end
            end)
        end)
    elseif not state and connections.fling then
        connections.fling:Disconnect()
        connections.fling = nil
    end
end

local function setSpeed(state)
    features.speed = state
    if state and not connections.speed then
        connections.speed = RunService.Heartbeat:Connect(function()
            if not features.speed then return end
            pcall(function()
                if humanoid and humanoid.Parent then
                    humanoid.WalkSpeed = speedValue
                    humanoid.JumpPower = speedValue
                end
            end)
        end)
    elseif not state and connections.speed then
        connections.speed:Disconnect()
        connections.speed = nil
        pcall(function()
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
            end
        end)
    end
end

local currentAngle = 0
local function setSpin360(state)
    features.spin360 = state
    if state and not connections.spin360 then
        connections.spin360 = RunService.RenderStepped:Connect(function()
            if not features.spin360 then return end
            pcall(function()
                if rootPart and rootPart.Parent then
                    currentAngle = (currentAngle + spinSpeedValue) % 360
                    rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, math.rad(currentAngle), 0)
                end
            end)
        end)
    elseif not state and connections.spin360 then
        connections.spin360:Disconnect()
        connections.spin360 = nil
    end
end

local function taoSlider(parentScroll, title, minVal, maxVal, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -8, 0, 50)
    Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    Frame.BorderSizePixel = 0
    Frame.Parent = parentScroll

    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -20, 0, 20)
    Title.Position = UDim2.new(0, 10, 0, 5)
    Title.BackgroundTransparency = 1
    Title.Text = title
    Title.TextColor3 = Color3.fromRGB(220, 220, 220)
    Title.TextSize = 12
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Frame

    local ValLabel = Instance.new("TextLabel")
    ValLabel.Size = UDim2.new(0, 50, 0, 20)
    ValLabel.Position = UDim2.new(1, -60, 0, 5)
    ValLabel.BackgroundTransparency = 1
    ValLabel.Text = tostring(defaultVal)
    ValLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
    ValLabel.TextSize = 12
    ValLabel.Font = Enum.Font.GothamBold
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValLabel.Parent = Frame

    local SliderBar = Instance.new("TextButton")
    SliderBar.Size = UDim2.new(1, -20, 0, 6)
    SliderBar.Position = UDim2.new(0, 10, 0, 32)
    SliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    SliderBar.Text = ""
    SliderBar.BorderSizePixel = 0
    SliderBar.Parent = Frame

    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)

    local initialScale = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(initialScale, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    Fill.BorderSizePixel = 0
    Fill.Parent = SliderBar

    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame", SliderBar)
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new(initialScale, 0, 0.5, 0)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    
    local knobCorner = Instance.new("UICorner", Knob)
    knobCorner.CornerRadius = UDim.new(1, 0)

    local dragging = false
    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position.X
            local barPos = SliderBar.AbsolutePosition.X
            local barSize = SliderBar.AbsoluteSize.X
            if barSize > 0 then
                local scale = math.clamp((pos - barPos) / barSize, 0, 1)
                Fill.Size = UDim2.new(scale, 0, 1, 0)
                Knob.Position = UDim2.new(scale, 0, 0.5, 0)
                
                local val = math.floor(minVal + (maxVal - minVal) * scale + 0.5)
                ValLabel.Text = tostring(val)
                if callback then callback(val) end
            end
        end
    end)

    return Frame
end

